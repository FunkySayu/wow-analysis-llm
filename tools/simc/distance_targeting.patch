diff --git a/engine/action/action.cpp b/engine/action/action.cpp
index 72555b9bb7..cbfafddbed 100644
--- a/engine/action/action.cpp
+++ b/engine/action/action.cpp
@@ -5372,16 +5372,13 @@ player_t* action_t::select_target_if_target()
   std::vector<player_t*> master_list;
   if ( sim->distance_targeting_enabled )
   {
-    if ( !target_cache.is_valid )
-    {
-      available_targets( target_cache.list );
-      master_list = targets_in_range_list( target_cache.list );
-      target_cache.is_valid = true;
-    }
-    else
-    {
-      master_list = target_cache.list;
-    }
+    // Vendored fix (wow-analysis): candidates are every target in range of the player,
+    // built locally. The stock code reused target_cache, which target_list() filters by
+    // splash radius around the *current* target -- so an AoE spell could never target_if
+    // onto a separate group -- and when it rebuilt the cache it stored this unfiltered
+    // list as valid, so the spell's next AoE silently ignored its radius.
+    available_targets( master_list );
+    master_list = targets_in_range_list( master_list );
 
     sim->print_debug( "{} Number of targets found in range: {}", *player, master_list.size() );
 
diff --git a/engine/class_modules/sc_druid.cpp b/engine/class_modules/sc_druid.cpp
