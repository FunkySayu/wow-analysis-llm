     druid_heal_t::execute();
 
     params.start_time( timespan_t::min() )  // reset start time
+      .x( target->x_position )  // vendored fix (wow-analysis): params persist across casts and
+      .y( target->y_position )  // target() only sets x/y while they are -1, so re-aim every cast
       .target( target );
 
     make_event<ground_aoe_event_t>( *sim, p(), params );
@@ -7425,6 +7427,8 @@ struct fury_of_elune_t final : public druid_spell_t
     energize_buff->trigger( params.duration() );
 
     params.start_time( timespan_t::min() )  // reset start time
+      .x( target->x_position )  // vendored fix (wow-analysis): params persist across casts and
+      .y( target->y_position )  // target() only sets x/y while they are -1, so re-aim every cast
       .target( target );
 
     make_event<ground_aoe_event_t>( *sim, p(), params );
diff --git a/engine/player/ground_aoe.cpp b/engine/player/ground_aoe.cpp
index 4e625914ba..eaee528a61 100644
--- a/engine/player/ground_aoe.cpp
+++ b/engine/player/ground_aoe.cpp
@@ -220,6 +220,21 @@ void ground_aoe_event_t::execute()
                          pulse_time( false ).total_seconds() );
     }
 
+    // Vendored fix (wow-analysis): with distance targeting the pulse action's target
+    // cache is filtered against its *previous* execute_state position, so a ground
+    // effect re-cast somewhere else kept hitting the old spot's targets. Rebuild the
+    // list from this pulse's own coordinates.
+    if ( sim().distance_targeting_enabled )
+    {
+      spell_->set_target( params->target() );
+      if ( spell_->execute_state )
+      {
+        spell_->execute_state->original_x = params->x();
+        spell_->execute_state->original_y = params->y();
+      }
+      spell_->target_cache.is_valid = false;
+    }
+
     // Compute nd initialize number of targets hit for amount multipliers based on it
     std::vector<player_t*>& tl = spell_->target_list();
     const int max_targets      = as<int>( tl.size() );
