# ==========================================================================
# The Twin Fangs (Mythic) -- full-kill fight script, generated by make_fight.py
#
# Measured, not looked up: medians over 30 kills sampled (seed 20261005) from the
# 178 unique pulls in the top-200 world character rankings, all classes. Every
# scheduled anchor below has a population stddev of 0.08s across those pulls.
#
#   REFERENCE PULL vP4RTacqbCNzd9JV#9 (validation only)
#   fight length                      424.2s  -> 424s
#   first boss death                  401.9s  (Vexhul first in 24/30 pool pulls)
#   Vile Flood begincasts             136.1 / 291.1  -> bosses split ~24s
#   Spawn of Vexhul waves (begincast, then adds at +1/+2/+3s, median life from spawn):
#     wave 1    33.0s   lifetimes 11.0 / 14.6 / 13.6s   (n=1)
#     wave 2    94.0s   lifetimes 10.9 / 11.5 / 11.7s   (n=1)
#     wave 3   188.0s   lifetimes 9.1 / 11.6 / 10.3s   (n=1)
#     wave 4   249.0s   lifetimes 10.6 / 15.0 / 12.9s   (n=1)
#     wave 5   343.1s   lifetimes 14.1 / 10.6 / 12.1s   (n=1)
#
# Geometry (the whole point of the script): the two bosses are stacked, the three
# Spawns are stacked with each other, and the two groups are out of each other's
# splash range. Measured from Shidann's log: Starfire and Fury of Elune cast on a
# boss hit both bosses and NEVER a Spawn (88 Starfire casts hit both bosses, 0 hit a
# Spawn), while Lunar Bolt / Bombardments cast on a Spawn hit all three Spawns.
# Expressed with simc distance targeting: bosses at (0,0), Spawns at (-15,25) --
# ~29yd from both the bosses and the player, so in range to be cast on, but outside
# every target-centred splash radius.
#
# Barbed Bulwark (Blood Torrent's globule shields) is deliberately not modelled and is
# excluded from every log-side damage number: it is not a target a DPS chooses.
# Broodlings of Ithraz (interrupt-to-retreat, ~4-5s lives) are not modelled either --
# they took 3.3M of Shidann's 151M, mostly as Starfall collateral.
# ==========================================================================

max_time=424
fixed_time=1
vary_combat_length=0
desired_targets=1
distance_targeting_enabled=1

# Ithraz is sim->target (the APL's default target) because he outlives Vexhul in the
# median pull. Both are type ENEMY, so with merge_enemy_priority_dmg both count as
# boss damage (prioritydps); the Spawns (type=add) do not.
enemy=Ithraz
x_pos=0
y_pos=0
enemy=Vexhul
x_pos=0
y_pos=0

# Vexhul dies at the median first-boss death. `invulnerable` on her clears her dots
# and refuses every harmful cast -- a dead boss, for simc's purposes. (In 6/30 pulls
# Ithraz dies first; the median pull is Vexhul.)
raid_events+=/invulnerable,target=Vexhul,timestamps=401.9,duration=27.1
# ...and moved out of every splash radius: an invulnerable target still takes 0-damage
# "hits" and so still counts toward AoE target-count scaling (seen in the trace).
raid_events+=/move_enemy,enemy_name=Vexhul,x=500,y=0,timestamps=401.9,duration=27.1

# Vile Flood: the bosses separate for ~24s. Ithraz is moved 29yd away so a boss-
# targeted Starfire / Fury of Elune hits one boss only, as in the log.
raid_events+=/move_enemy,enemy_name=Ithraz,x=-15,y=-25,timestamps=133.6,duration=24.0
raid_events+=/move_enemy,enemy_name=Ithraz,x=-15,y=-25,timestamps=288.6,duration=24.0

# Boss-side damage amp relative to a Spawn: 1.135x. Measured two independent ways on
# Shidann's log inside the add windows: amount/unmitigatedAmount on non-crits gives
# boss/Spawn 1.135 (Moonfire), 1.138 (Sunfire), 1.149 (Starfall), 1.145 (Shooting
# Stars); same-tick Starfall pairs give 1.126. It is raid-applied (it steps between
# 1.06 and 1.30 over the fight) and the Spawns live too briefly to collect it. This is
# the exchange rate between "damage on a Spawn" and "damage on a boss".
#
# TRAP: `multiplier=` is the damage-taken INCREASE, not the factor -- player.cpp applies
# `m *= 1.0 + debuffs.vulnerable->check_value()`. multiplier=1.135 gives 2.135x (that
# mistake inflated every bucket ~1.9x on the first validation run); 0.135 gives 1.135x.
raid_events+=/vulnerable,target=Ithraz,timestamps=0.01,duration=429,multiplier=0.135
raid_events+=/vulnerable,target=Vexhul,timestamps=0.01,duration=401.89,multiplier=0.135

# Spawn of Vexhul. One raid event per add so the 1-1-1 cadence is exact. Named
# spawn_<a|b|c>_w<N>: APL expressions match raid events by NAME PREFIX, so
# raid_event.spawn_a.in = time to the next wave, raid_event.spawn.remains = the
# longest-lived Spawn currently up. `duration=` not `health=`: one druid does not
# kill a 12.2M add, the other 19 players do, and the measured lifetime is the window
# the rotation actually gets.
raid_events+=/adds,name=spawn_a_w1,count=1,timestamps=34.0,duration=11.0,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_b_w1,count=1,timestamps=35.0,duration=14.6,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_c_w1,count=1,timestamps=36.0,duration=13.6,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_a_w2,count=1,timestamps=95.0,duration=10.9,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_b_w2,count=1,timestamps=96.0,duration=11.5,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_c_w2,count=1,timestamps=97.0,duration=11.7,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_a_w3,count=1,timestamps=189.0,duration=9.1,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_b_w3,count=1,timestamps=190.0,duration=11.6,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_c_w3,count=1,timestamps=191.0,duration=10.3,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_a_w4,count=1,timestamps=250.0,duration=10.6,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_b_w4,count=1,timestamps=251.0,duration=15.0,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_c_w4,count=1,timestamps=252.0,duration=12.9,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_a_w5,count=1,timestamps=344.1,duration=14.1,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_b_w5,count=1,timestamps=345.1,duration=10.6,spawn_x=-15,spawn_y=25
raid_events+=/adds,name=spawn_c_w5,count=1,timestamps=346.1,duration=12.1,spawn_x=-15,spawn_y=25

# --- raid buffs -----------------------------------------------------------
# Heroism at 0.1s in the reference pull (simc default bloodlust_time=0).
override.bloodlust=1
override.arcane_intellect=1
override.power_word_fortitude=1
override.battle_shout=1
override.mystic_touch=1
override.chaos_brand=1
override.skyfury=1
override.mark_of_the_wild=1
override.hunters_mark=1
override.bleeding=1

midnight.crucible_of_erratic_energies_violence=1
midnight.crucible_of_erratic_energies_sustenance=1
midnight.crucible_of_erratic_energies_predation=1

iterations=10000
merge_enemy_priority_dmg=1
optimize_expressions=1
single_actor_batch=1
report_details=1
